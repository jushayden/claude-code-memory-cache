{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph status",
            "statusMessage": "Checking code graph freshness"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} {{REPO}}/scripts/codex_hook_shim.py --post",
            "statusMessage": "Refreshing code graph"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} {{REPO}}/memory_server/codex_rollout_ingest.py",
            "statusMessage": "Logging session to vault"
          }
        ]
      }
    ]
  }
}
